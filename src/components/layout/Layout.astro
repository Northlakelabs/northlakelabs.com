---
import MobileMenu from '../ui/MobileMenu.astro';
import SEOHead from '../seo/SEOHead.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = "Biomechanics × AI. Custom solutions for research, clinical, and sports applications.",
  image,
  type = 'website',
} = Astro.props;

const siteUrl = 'https://www.northlakelabs.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Northlake Labs",
  "url": siteUrl,
  "description": "Biomechanics × AI. Custom solutions for research, clinical, and sports applications.",
  "publisher": {
    "@type": "Organization",
    "name": "Northlake Labs",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/assets/northlake_logo.png`
    }
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <SEOHead
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    type={type}
    image={image || `${siteUrl}/assets/northlake_logo.png`}
    jsonLd={jsonLd}
    appendSiteName={false}
  />

  <!-- Google Search Console verification -->
  <meta name="google-site-verification" content="1NvolXOCn59iDWOz8FKQtYKpMRiq9z4qkKvNswpmEF0" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <title>{title}</title>
</head>
<body class="bg-black-pearl text-white min-h-screen antialiased">
  <div style="isolation: isolate;">
    <slot />
    
    <!-- Subtle background grain -->
    <div class="fixed inset-0 pointer-events-none z-0 opacity-[0.015]" 
         style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
    
    <!-- Very subtle gradient glow -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-burnt-sienna/[0.03] rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-royal-purple/[0.03] rounded-full blur-3xl"></div>
    </div>
  </div>

  <MobileMenu />
</body>
</html>
