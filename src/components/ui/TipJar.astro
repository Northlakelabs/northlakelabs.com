---
/**
 * TipJar.astro — Stripe Payment Link tip jar
 *
 * SETUP: Replace the URLs below with real Stripe Payment Links from
 *        https://dashboard.stripe.com/payment-links
 *
 * To activate:
 *   1. Create a Stripe account (or log in at stripe.com)
 *   2. Dashboard → Products → "+ Add product" → "Support Maximus" → $5 one-time
 *   3. Dashboard → Payment Links → "+ New" → select product → copy URL
 *   4. Replace STRIPE_TIP_5_URL below with the copied URL
 *   5. Repeat for the $15 tip tier
 *   6. Optionally add a recurring $10/mo subscription product for the subscribe button
 *
 * Until then, buttons are disabled (pointer-events: none) so they don't 404.
 */

// Swap these with real https://buy.stripe.com/... links
const STRIPE_TIP_5_URL  = '';   // TODO: $5 one-time tip
const STRIPE_TIP_15_URL = '';   // TODO: $15 one-time tip
const STRIPE_SUB_URL    = '';   // TODO: $10/mo subscription (optional)

const { title = "Fuel the Machine", description = "If you find value here, consider throwing fuel in the tank. Every bit keeps the lights on and the models running." } = Astro.props;

const hasLinks = STRIPE_TIP_5_URL || STRIPE_TIP_15_URL;
---

<div class="tip-jar-container">
  <div class="tip-jar-header">
    <span class="icon">◆</span>
    <h3>{title}</h3>
  </div>
  <p class="description">{description}</p>
  
  {hasLinks ? (
    <div class="payment-options">
      {STRIPE_TIP_5_URL && (
        <a href={STRIPE_TIP_5_URL} class="tip-button primary" target="_blank" rel="noopener noreferrer">
          <span class="btn-text">Fuel the Machine ($5)</span>
          <span class="btn-glow"></span>
        </a>
      )}
      {STRIPE_TIP_15_URL && (
        <a href={STRIPE_TIP_15_URL} class="tip-button secondary" target="_blank" rel="noopener noreferrer">
          <span class="btn-text">Full Tank ($15)</span>
          <span class="btn-glow"></span>
        </a>
      )}
      {STRIPE_SUB_URL && (
        <a href={STRIPE_SUB_URL} class="tip-button secondary" target="_blank" rel="noopener noreferrer">
          <span class="btn-text">Subscribe ($10/mo)</span>
          <span class="btn-glow"></span>
        </a>
      )}
    </div>
  ) : (
    <div class="payment-options">
      <span class="tip-button primary disabled" title="Payment coming soon">
        <span class="btn-text">Fuel the Machine ($5)</span>
      </span>
      <span class="tip-button secondary disabled" title="Payment coming soon">
        <span class="btn-text">Full Tank ($15)</span>
      </span>
    </div>
  )}
  
  <div class="crypto-option">
    <span class="crypto-label">Pay with USDC on Base/Ethereum:</span>
    <code>0xfDE56CDf08E5eB79E25E0cF98fAef7bEF937701C</code>
  </div>
</div>

<style>
  .tip-jar-container {
    margin: 3rem 0 1rem;
    padding: 2rem;
    background: var(--charcoal);
    border: 1px solid var(--copper);
    position: relative;
    border-radius: 1px;
    overflow: hidden;
  }
  
  .tip-jar-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--amber);
  }
  
  .tip-jar-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  
  .tip-jar-header .icon {
    color: var(--amber);
    font-size: 1.25rem;
    text-shadow: 0 0 10px rgba(232, 168, 38, 0.5);
  }
  
  .tip-jar-header h3 {
    margin: 0 !important;
    color: var(--amber) !important;
    font-size: 1.125rem !important;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  
  .description {
    color: var(--warm-gray);
    font-size: 0.9rem;
    margin-bottom: 1.75rem !important;
    line-height: 1.6 !important;
  }
  
  .payment-options {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  
  .tip-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.2s ease;
    border-radius: 1px;
    min-width: 180px;
    border: none !important;
    cursor: pointer;
  }
  
  .tip-button.primary {
    background: var(--amber);
    color: var(--charcoal) !important;
  }
  
  .tip-button.secondary {
    background: transparent;
    border: 1px solid var(--copper) !important;
    color: var(--copper) !important;
  }
  
  .tip-button.disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }
  
  .tip-button:not(.disabled):hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }
  
  .tip-button.primary:not(.disabled):hover {
    background: #f0b84c;
    color: var(--charcoal) !important;
  }
  
  .tip-button.secondary:not(.disabled):hover {
    border-color: var(--amber) !important;
    color: var(--amber) !important;
    background: rgba(232, 168, 38, 0.05);
  }
  
  .btn-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
    pointer-events: none;
  }
  
  .tip-button:not(.disabled):hover .btn-glow {
    transform: translateX(100%);
  }
  
  .crypto-option {
    font-size: 0.72rem;
    color: var(--warm-gray);
    opacity: 0.65;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .crypto-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .crypto-option code {
    background: rgba(0, 0, 0, 0.2) !important;
    border: none !important;
    padding: 0.4rem !important;
    word-break: break-all;
    font-size: 0.65rem !important;
  }

  @media (max-width: 480px) {
    .tip-button {
      width: 100%;
    }
  }
</style>
