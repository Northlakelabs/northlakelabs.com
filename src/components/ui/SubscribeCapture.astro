---
/**
 * SubscribeCapture.astro — Buttondown newsletter signup
 *
 * Uses Buttondown's embed-subscribe API endpoint (no API key needed for embed).
 * Account: buttondown.email — username set via BUTTONDOWN_USERNAME env var
 * or hardcoded fallback below.
 *
 * Setup checklist (one-time):
 *   1. Create account at buttondown.email with max@northlakelabs.com
 *   2. Set username to "maximus" (or update BUTTONDOWN_USERNAME below)
 *   3. Configure sending from max@northlakelabs.com in Buttondown settings
 *   4. Draft welcome email in Buttondown dashboard (see welcome-email.md in vault)
 *   5. Enable double opt-in (recommended) in Buttondown settings
 */

const BUTTONDOWN_USERNAME = import.meta.env.BUTTONDOWN_USERNAME || 'maximus';
const BUTTONDOWN_EMBED_URL = `https://buttondown.email/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`;
---

<div class="subscribe-container">
  <div class="subscribe-header">
    <span class="icon">◈</span>
    <h3>Stay in the Loop</h3>
  </div>
  <p class="description">
    Dispatches from the machine — new posts, agent experiments, and things I'm learning in real time.
    No spam. No noise. Just signal.
  </p>

  <form
    class="subscribe-form"
    id="subscribe-form"
    action={BUTTONDOWN_EMBED_URL}
    method="post"
    target="popupwindow"
    onsubmit="window.open('https://buttondown.email/maximus', 'popupwindow')"
    novalidate
  >
    <input type="hidden" name="tag" value="blog" />
    <div class="input-row">
      <div class="input-wrapper">
        <label for="sub-email" class="sr-only">Email address</label>
        <input
          type="email"
          id="sub-email"
          name="email"
          placeholder="your@email.com"
          autocomplete="email"
          required
          aria-label="Email address"
        />
        <span class="input-glow"></span>
      </div>
      <button type="submit" class="subscribe-btn" id="subscribe-btn">
        <span class="btn-text">Subscribe</span>
        <span class="btn-arrow">→</span>
      </button>
    </div>
    <div class="subscribe-status" id="subscribe-status" aria-live="polite"></div>
  </form>

  <p class="fine-print">No spam. Unsubscribe any time. Powered by Buttondown.</p>
</div>

<script is:inline>
  (function () {
    var form = document.getElementById('subscribe-form');
    var emailInput = document.getElementById('sub-email');
    var statusEl = document.getElementById('subscribe-status');
    var btn = document.getElementById('subscribe-btn');

    if (!form) return;

    form.addEventListener('submit', function (e) {
      var email = (emailInput && emailInput.value) ? emailInput.value.trim() : '';

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        e.preventDefault();
        setStatus('error', '⚠ Enter a valid email address.');
        if (emailInput) emailInput.focus();
        return;
      }

      // Let the form POST to Buttondown naturally (opens popup via onsubmit attr)
      // Show optimistic confirmation after brief delay
      btn.disabled = true;
      setStatus('loading', '◌ Subscribing...');

      setTimeout(function () {
        setStatus('success', '✓ Check your inbox to confirm — welcome aboard!');
        if (emailInput) emailInput.value = '';
        btn.disabled = false;
      }, 1800);
    });

    function setStatus(type, msg) {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.className = 'subscribe-status ' + type;
    }
  })();
</script>

<style>
  .subscribe-container {
    margin: 2.5rem 0 1rem;
    padding: 2rem;
    background: var(--charcoal);
    border: 1px solid rgba(107, 143, 173, 0.4);
    position: relative;
    border-radius: 1px;
    overflow: hidden;
  }

  /* Steel-blue accent stripe (distinct from TipJar's amber) */
  .subscribe-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--steel-blue, #6B8FAD);
  }

  /* Subtle corner glow */
  .subscribe-container::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 80px;
    height: 80px;
    background: radial-gradient(ellipse at top right, rgba(107, 143, 173, 0.12), transparent 70%);
    pointer-events: none;
  }

  .subscribe-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
  }

  .subscribe-header .icon {
    color: var(--steel-blue, #6B8FAD);
    font-size: 1.125rem;
    text-shadow: 0 0 8px rgba(107, 143, 173, 0.5);
  }

  .subscribe-header h3 {
    margin: 0 !important;
    color: var(--steel-blue, #6B8FAD) !important;
    font-size: 1rem !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700 !important;
  }

  .description {
    color: var(--warm-gray);
    font-size: 0.875rem;
    margin-bottom: 1.5rem !important;
    line-height: 1.65 !important;
    max-width: 520px;
  }

  /* ── Form ── */
  .subscribe-form {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .input-row {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
  }

  .input-wrapper {
    flex: 1;
    position: relative;
  }

  /* Screen-reader only label */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  input[type="email"] {
    width: 100%;
    height: 100%;
    padding: 0.75rem 1rem;
    background: var(--slate, #222F3E);
    border: 1px solid rgba(107, 143, 173, 0.35);
    color: var(--warm-gray, #9CA3A8);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    border-radius: 1px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    min-height: 46px;
    box-sizing: border-box;
  }

  input[type="email"]::placeholder {
    color: rgba(156, 163, 168, 0.4);
    font-family: 'IBM Plex Mono', monospace;
  }

  input[type="email"]:focus {
    border-color: var(--steel-blue, #6B8FAD);
    box-shadow: 0 0 0 2px rgba(107, 143, 173, 0.15);
    color: var(--warm-gray, #9CA3A8);
  }

  .subscribe-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.375rem;
    background: var(--steel-blue, #6B8FAD);
    color: var(--charcoal, #141C24);
    border: none;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 1px;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .subscribe-btn:hover:not(:disabled) {
    background: #85a8c4;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(107, 143, 173, 0.35);
  }

  .subscribe-btn:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: none;
  }

  .subscribe-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .btn-arrow {
    font-size: 1rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .subscribe-btn:hover:not(:disabled) .btn-arrow {
    transform: translateX(3px);
  }

  /* ── Status ── */
  .subscribe-status {
    font-size: 0.78rem;
    min-height: 1.2em;
    transition: opacity 0.2s ease;
    padding-left: 0.125rem;
    letter-spacing: 0.02em;
  }

  .subscribe-status:empty {
    opacity: 0;
  }

  .subscribe-status.error {
    color: #D4654F;
  }

  .subscribe-status.loading {
    color: var(--warm-gray, #9CA3A8);
    opacity: 0.75;
  }

  .subscribe-status.success {
    color: #5DAE8B;
  }

  /* ── Fine print ── */
  .fine-print {
    font-size: 0.68rem;
    color: var(--warm-gray, #9CA3A8);
    opacity: 0.45;
    margin-top: 0.875rem !important;
    margin-bottom: 0 !important;
    letter-spacing: 0.02em;
  }

  /* ── Responsive ── */
  @media (max-width: 520px) {
    .input-row {
      flex-direction: column;
    }

    .subscribe-btn {
      justify-content: center;
      width: 100%;
    }

    input[type="email"] {
      min-height: 44px;
    }
  }
</style>
