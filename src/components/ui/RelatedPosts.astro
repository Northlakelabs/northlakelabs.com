---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
  currentTags: string[];
  maxPosts?: number;
}

const { currentSlug, currentTags, maxPosts = 3 } = Astro.props;

// Fetch all posts from the max-blog collection
const allPosts = await getCollection('max-blog');

// Filter and score posts by tag overlap
const relatedPosts = allPosts
  .filter(post => post.slug !== currentSlug && post.data.tags)
  .map(post => {
    // Count overlapping tags
    const tagOverlap = post.data.tags.filter(tag => 
      currentTags.includes(tag)
    ).length;
    
    return {
      ...post,
      tagOverlap
    };
  })
  .filter(post => post.tagOverlap > 0) // Only include posts with at least 1 shared tag
  .sort((a, b) => b.tagOverlap - a.tagOverlap) // Sort by overlap count
  .slice(0, maxPosts); // Limit to maxPosts

// Don't render if no related posts found
---

{relatedPosts.length > 0 && (
<div class="related-posts-section">
  <div class="related-header">
    <span class="icon">→</span>
    <h3>Related Posts</h3>
  </div>
  
  <div class="related-grid">
    {relatedPosts.map(post => (
      <a href={`/max/blog/${post.slug}/`} class="related-card">
        <div class="card-inner">
          <div class="card-meta">
            <span class="card-date">
              {post.data.date.toLocaleDateString('en-US', { 
                month: 'short', 
                day: 'numeric',
                year: '2-digit'
              })}
            </span>
            {post.tagOverlap > 0 && (
              <span class="tag-match">
                +{post.tagOverlap} tag{post.tagOverlap !== 1 ? 's' : ''}
              </span>
            )}
          </div>
          
          <h4 class="card-title">{post.data.title}</h4>
          <p class="card-excerpt">{post.data.excerpt}</p>
          
          <div class="card-tags">
            {post.data.tags.filter(tag => 
              currentTags.includes(tag)
            ).map(tag => (
              <span class="shared-tag">#{tag}</span>
            ))}
          </div>
        </div>
        
        <div class="card-hover-glow"></div>
      </a>
    ))}
  </div>
</div>
)}

<style>
  .related-posts-section {
    margin: 3rem 0 0;
    padding: 2rem 0 0;
    border-top: 1px solid rgba(232, 168, 38, 0.2);
  }
  
  .related-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }
  
  .related-header .icon {
    color: var(--amber);
    font-size: 1.25rem;
    text-shadow: 0 0 10px rgba(232, 168, 38, 0.5);
  }
  
  .related-header h3 {
    margin: 0 !important;
    color: var(--amber) !important;
    font-size: 1.125rem !important;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  
  .related-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--slate);
    border: 1px solid rgba(212, 129, 63, 0.4);
    text-decoration: none !important;
    color: inherit;
    transition: all 0.3s ease;
    border-radius: 1px;
    overflow: hidden;
  }
  
  .related-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background: var(--copper);
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }
  
  .related-card:hover {
    border-color: var(--amber);
    background: rgba(34, 47, 62, 0.8);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  
  .related-card:hover::before {
    opacity: 1;
  }
  
  .card-inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    gap: 0.5rem;
  }
  
  .card-date {
    font-size: 0.7rem;
    color: var(--copper);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .tag-match {
    font-size: 0.65rem;
    color: var(--amber);
    background: rgba(232, 168, 38, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 1px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  
  .card-title {
    margin: 0 0 0.75rem !important;
    color: var(--amber) !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.025em;
    line-height: 1.4 !important;
  }
  
  .card-excerpt {
    margin: 0 0 1rem !important;
    color: var(--warm-gray);
    font-size: 0.85rem !important;
    line-height: 1.5 !important;
    flex-grow: 1;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }
  
  .shared-tag {
    font-size: 0.7rem;
    color: var(--copper);
    background: rgba(212, 129, 63, 0.15);
    padding: 0.25rem 0.5rem;
    border-radius: 1px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(212, 129, 63, 0.3);
  }
  
  .card-hover-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, transparent, rgba(232, 168, 38, 0.05), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  
  .related-card:hover .card-hover-glow {
    opacity: 1;
  }
  
  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .related-card {
      padding: 1.25rem;
    }
    
    .card-title {
      font-size: 0.95rem !important;
    }
    
    .card-excerpt {
      font-size: 0.8rem !important;
    }
  }
</style>
