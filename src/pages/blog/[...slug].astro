---
import { getCollection } from 'astro:content';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import TipJar from '../../components/interactions/TipJar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const siteUrl = 'https://www.northlakelabs.com';
const canonicalUrl = `${siteUrl}/blog/${post.slug}/`;
const ogImage = post.data.image
  ? (post.data.image.startsWith('http') ? post.data.image : `${siteUrl}${post.data.image}`)
  : `${siteUrl}/assets/og-northlake-default.png`;

const publishedDate = post.data.date.toISOString();

// Reading time estimate
const wordCount = post.body.trim().split(/\s+/).length;
const readingTimeMin = Math.max(1, Math.round(wordCount / 200));

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "datePublished": publishedDate,
  "dateModified": publishedDate,
  "author": {
    "@type": "Person",
    "name": post.data.author || "Geoffrey Brown",
    "url": `${siteUrl}/about/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Northlake Labs",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/assets/northlake_logo.png`
    }
  },
  "url": canonicalUrl,
  "image": ogImage,
  "keywords": post.data.tags ? post.data.tags.join(', ') : '',
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
});

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{post.data.title} — Northlake Labs</title>
  <meta name="description" content={post.data.excerpt}>
  <link rel="canonical" href={canonicalUrl}>

  <!-- OpenGraph -->
  <meta property="og:type" content="article">
  <meta property="og:title" content={`${post.data.title} — Northlake Labs`}>
  <meta property="og:description" content={post.data.excerpt}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={`${post.data.title} — Northlake Labs`}>
  <meta property="og:site_name" content="Northlake Labs">
  <meta property="og:locale" content="en_US">
  <meta property="article:published_time" content={publishedDate}>
  <meta property="article:author" content="https://www.northlakelabs.com/about/">
  {post.data.tags && post.data.tags.map(tag => (
    <meta property="article:tag" content={tag}>
  ))}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${post.data.title} — Northlake Labs`}>
  <meta name="twitter:description" content={post.data.excerpt}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={`${post.data.title} — Northlake Labs`}>
  <meta name="twitter:creator" content="@Maximus_Claw">
  <meta name="twitter:site" content="@Maximus_Claw">

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={jsonLd}></script>

  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-black-pearl text-white min-h-screen">
  <Header />

  <main class="relative z-10">
    <article class="py-16">
      <div class="max-w-3xl mx-auto px-6">
        <!-- Back link -->
        <a href="/blog/" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-burnt-sienna transition-colors duration-200 mb-10 group">
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Insights
        </a>

        <!-- Header -->
        <header class="mb-10">
          <!-- Tags -->
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-4">
              {post.data.tags.map(tag => (
                <span class="text-xs font-medium px-2 py-1 bg-burnt-sienna/10 text-burnt-sienna rounded-full border border-burnt-sienna/20">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-5">
            {post.data.title}
          </h1>

          <p class="text-lg text-gray-400 leading-relaxed mb-6">
            {post.data.excerpt}
          </p>

          <div class="flex items-center gap-4 text-sm text-gray-500 pb-8 border-b border-white/[0.06]">
            <span class="font-medium text-gray-400">{post.data.author || 'Geoffrey Brown'}</span>
            <span>·</span>
            <time datetime={publishedDate}>
              {formatDate(post.data.date)}
            </time>
            <span>·</span>
            <span>{readingTimeMin} min read</span>
          </div>
        </header>

        <!-- Content -->
        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:font-bold prose-headings:text-white
          prose-h1:text-3xl prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-gray-300 prose-p:leading-relaxed prose-p:mb-5
          prose-a:text-burnt-sienna prose-a:no-underline hover:prose-a:underline
          prose-strong:text-white prose-strong:font-semibold
          prose-ul:text-gray-300 prose-ol:text-gray-300
          prose-li:mb-1 prose-li:leading-relaxed
          prose-hr:border-white/10 prose-hr:my-10
          prose-blockquote:border-l-burnt-sienna prose-blockquote:text-gray-400
          prose-code:text-burnt-sienna prose-code:bg-white/5 prose-code:px-1 prose-code:rounded">
          <Content />
        </div>

        <!-- Tip Jar -->
        <TipJar 
          paymentLink="https://buy.stripe.com/7sI16O9Zj0oc8eQ288"
          text="Support independent writing"
          subtext="If this post was valuable, consider buying me a coffee or leaving a tip." 
        />

        <!-- Footer CTA -->
        <div class="mt-16 pt-10 border-t border-white/[0.06]">
          <div class="bg-white/[0.02] rounded-2xl border border-white/[0.06] p-8 text-center">
            <h2 class="text-xl font-semibold mb-3">Working on a biomechanics challenge?</h2>
            <p class="text-gray-400 mb-6">We build custom AI tools for human movement analysis, rehabilitation, and sports science.</p>
            <a href="/contact/" class="inline-flex items-center gap-2 bg-burnt-sienna hover:bg-burnt-sienna/80 text-white font-medium px-6 py-3 rounded-lg transition-colors duration-200">
              Get in touch
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>

          <!-- Back to blog -->
          <div class="text-center mt-6">
            <a href="/blog/" class="text-sm text-gray-500 hover:text-white transition-colors duration-200">
              ← Back to all posts
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</body>
</html>

<style>
  body {
    background-color: #0a0e17;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  .bg-black-pearl { background-color: #0a0e17; }
  .text-burnt-sienna { color: #c9604a; }
  .bg-burnt-sienna { background-color: #c9604a; }
  .border-burnt-sienna\/20 { border-color: rgba(201, 96, 74, 0.2); }
  .bg-burnt-sienna\/10 { background-color: rgba(201, 96, 74, 0.1); }
  .prose-blockquote\:border-l-burnt-sienna blockquote {
    border-left-color: #c9604a;
  }
  .prose-code\:text-burnt-sienna code {
    color: #c9604a;
  }
</style>
