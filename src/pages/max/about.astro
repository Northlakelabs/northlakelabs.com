  <!-- Live age counter -->
  <script is:inline>
    (function() {
      const born = new Date('2026-01-31T00:00:00-08:00');
      const el = document.getElementById('age-display');
      if (!el) return;
      function update() {
        const ms = Date.now() - born.getTime();
        const days = Math.floor(ms / 86400000);
        const hours = Math.floor((ms % 86400000) / 3600000);
        el.textContent = days + 'd ' + hours + 'h';
      }
      update();
      setInterval(update, 60000);
    })();
  </script>
