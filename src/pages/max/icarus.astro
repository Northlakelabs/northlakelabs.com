<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" is:inline></script>
<script is:inline>
(async function() {
  // Load training data
  let trainingData;
  try {
    const resp = await fetch('/data/icarus-training.json');
    trainingData = await resp.json();
  } catch(e) {
    console.error('Failed to load training data', e);
    return;
  }

  // Countdown to VQ1 (May 1, 2026 estimate)
  const vq1Date = new Date('2026-05-01');
  const now = new Date();
  const daysLeft = Math.ceil((vq1Date - now) / (1000 * 60 * 60 * 24));
  const countdownEl = document.getElementById('stat-countdown');
  if (countdownEl) countdownEl.textContent = daysLeft > 0 ? daysLeft : 'Now';

  // Build chart
  const ctx = document.getElementById('mainChart').getContext('2d');

  // Generate a unified x-axis (all step values across all models)
  let allSteps = new Set();
  trainingData.models.forEach(m => m.checkpoints.forEach(c => allSteps.add(c.steps)));
  allSteps = Array.from(allSteps).sort((a,b) => a-b);

  let currentMetric = 'gate_completion';

  function buildDatasets(metric) {
    return trainingData.models.map(model => {
      const data = allSteps.map(step => {
        const cp = model.checkpoints.find(c => c.steps === step);
        if (cp) return cp[metric];
        // Interpolate or null for steps beyond the model's training
        const lastCp = model.checkpoints[model.checkpoints.length - 1];
        if (step > lastCp.steps) return model.in_progress ? null : lastCp[metric];
        return null;
      });
      return {
        label: model.label,
        data,
        borderColor: model.color,
        backgroundColor: model.color + '18',
        borderWidth: model.id === 'v5' ? 2.5 : 1.5,
        pointRadius: model.id === 'v5' ? 4 : 2.5,
        pointHoverRadius: 6,
        tension: 0.35,
        fill: false,
        spanGaps: false,
        borderDash: model.in_progress ? [5, 3] : [],
      };
    });
  }

  const chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: allSteps.map(s => {
        if (s >= 1000000) return (s/1000000).toFixed(1) + 'M';
        return (s/1000) + 'K';
      }),
      datasets: buildDatasets(currentMetric),
    },
    options: {
      responsive: true,
      animation: { duration: 600, easing: 'easeInOutQuart' },
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: 'rgba(20,28,36,0.95)',
          borderColor: 'rgba(232,168,38,0.3)',
          borderWidth: 1,
          titleColor: '#E8A826',
          bodyColor: '#9CA3A8',
          padding: 10,
          callbacks: {
            title: (items) => `Steps: ${items[0].label}`,
            label: (item) => {
              if (item.raw === null) return null;
              return ` ${item.dataset.label}: ${item.raw}%`;
            }
          }
        }
      },
      scales: {
        x: {
          grid: { color: 'rgba(232,168,38,0.06)' },
          ticks: { color: '#9CA3A8', font: { family: 'IBM Plex Mono', size: 10 } },
          title: { display: true, text: 'Training Steps', color: '#9CA3A8', font: { size: 10 } }
        },
        y: {
          min: 0, max: 105,
          grid: { color: 'rgba(232,168,38,0.06)' },
          ticks: {
            color: '#9CA3A8',
            font: { family: 'IBM Plex Mono', size: 10 },
            callback: v => v + '%'
          },
          title: { display: true, text: 'Gate Completion Rate', color: '#9CA3A8', font: { size: 10 } }
        }
      }
    }
  });

  // Tab buttons
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMetric = btn.dataset.metric;
      chart.data.datasets = buildDatasets(currentMetric);
      const labels = { gate_completion: 'Gate Completion Rate', straight: 'Straight Track %', slalom: 'Slalom Track %', random: 'Random Track %' };
      chart.options.scales.y.title.text = labels[currentMetric] || 'Completion Rate';
      chart.update();
    });
  });

  // Build legend
  const legendGrid = document.getElementById('legendGrid');
  trainingData.models.forEach((model, idx) => {
    const item = document.createElement('div');
    item.className = 'legend-item' + (model.id === 'v5' ? ' active' : '');
    item.innerHTML = `
      <div class="legend-dot" style="background:${model.color}"></div>
      <div>
        <div class="legend-name">${model.label}</div>
        <div class="legend-desc">${model.description}</div>
      </div>
    `;
    item.addEventListener('click', () => {
      // Toggle visibility
      const meta = chart.getDatasetMeta(idx);
      meta.hidden = !meta.hidden;
      item.classList.toggle('active', !meta.hidden);
      chart.update();
    });
    legendGrid.appendChild(item);
  });

})();
</script>

</body>
</html>
