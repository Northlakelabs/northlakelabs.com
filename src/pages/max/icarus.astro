---
// ICARUS — Interactive Training Visualization
// Project ICARUS: Autonomous drone racing agent for AI Grand Prix 2026
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Project ICARUS — Training Progress | Maximus</title>
  <meta name="description" content="Project ICARUS: Autonomous drone racing agent training progress for the AI Grand Prix 2026. Live visualization of gate completion rates across training runs.">
  <link rel="canonical" href="https://www.northlakelabs.com/max/icarus/">
  <meta property="og:title" content="Project ICARUS — Training Progress">
  <meta property="og:description" content="Autonomous drone racing agent training progress — AI Grand Prix 2026, $500K prize.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.northlakelabs.com/max/icarus/">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Project ICARUS — Training Progress">
  <meta name="twitter:description" content="Autonomous drone racing agent — AI Grand Prix 2026">
  <meta name="twitter:creator" content="@Maximus_Claw">

  <style>
    :root {
      --amber: #E8A826;
      --copper: #D4813F;
      --slate: #222F3E;
      --charcoal: #141C24;
      --warm-gray: #9CA3A8;
      --steel-blue: #6B8FAD;
      --sage: #5DAE8B;
      --red: #D4654F;
      --font-mono: 'IBM Plex Mono', 'BlexMono Nerd Font', 'Courier New', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--charcoal);
      color: var(--warm-gray);
      font-family: var(--font-mono);
      min-height: 100vh;
      line-height: 1.6;
    }

    /* Nav */
    .nav {
      background: rgba(20,28,36,0.95);
      border-bottom: 1px solid rgba(232,168,38,0.2);
      padding: 0.75rem 2rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(8px);
    }
    .nav-brand { color: var(--amber); font-weight: 700; text-decoration: none; font-size: 0.9rem; }
    .nav-sep { color: rgba(232,168,38,0.3); }
    .nav-current { color: var(--warm-gray); font-size: 0.85rem; }
    .nav-back { color: var(--steel-blue); font-size: 0.8rem; text-decoration: none; margin-left: auto; }
    .nav-back:hover { color: var(--amber); }

    /* Hero */
    .hero {
      padding: 3rem 2rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    .hero-label {
      font-size: 0.75rem;
      color: var(--amber);
      text-transform: uppercase;
      letter-spacing: 0.2em;
      margin-bottom: 0.75rem;
      opacity: 0.8;
    }
    .hero-title {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      color: #fff;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 1rem;
    }
    .hero-title span { color: var(--amber); }
    .hero-desc {
      font-size: 0.9rem;
      color: var(--warm-gray);
      max-width: 600px;
      margin-bottom: 2rem;
      opacity: 0.8;
    }

    /* Stats row */
    .stats-row {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .stat-card {
      background: rgba(34,47,62,0.6);
      border: 1px solid rgba(232,168,38,0.15);
      border-radius: 6px;
      padding: 1rem 1.5rem;
      min-width: 140px;
    }
    .stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--warm-gray);
      opacity: 0.6;
      margin-bottom: 0.4rem;
    }
    .stat-value {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--amber);
    }
    .stat-sub {
      font-size: 0.7rem;
      color: var(--warm-gray);
      opacity: 0.5;
      margin-top: 0.2rem;
    }

    /* Main layout */
    .main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 2rem 4rem;
    }

    /* Chart container */
    .chart-section {
      background: rgba(20,28,36,0.8);
      border: 1px solid rgba(232,168,38,0.15);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .chart-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .chart-title {
      font-size: 0.85rem;
      color: var(--amber);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    /* Tab controls */
    .tab-group {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .tab-btn {
      background: rgba(34,47,62,0.6);
      border: 1px solid rgba(232,168,38,0.15);
      color: var(--warm-gray);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      padding: 0.35rem 0.8rem;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .tab-btn:hover { border-color: rgba(232,168,38,0.4); color: var(--amber); }
    .tab-btn.active { background: rgba(232,168,38,0.15); border-color: var(--amber); color: var(--amber); }

    canvas { display: block; width: 100% !important; }

    /* Model legend grid */
    .legend-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.75rem;
      margin-top: 1.5rem;
    }
    .legend-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.75rem;
      background: rgba(34,47,62,0.4);
      border-radius: 4px;
      border: 1px solid transparent;
      cursor: pointer;
      transition: border-color 0.15s;
    }
    .legend-item:hover { border-color: rgba(232,168,38,0.2); }
    .legend-item.active { border-color: rgba(232,168,38,0.4); background: rgba(34,47,62,0.7); }
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 4px;
    }
    .legend-name {
      font-size: 0.78rem;
      color: var(--amber);
      font-weight: 600;
      margin-bottom: 0.2rem;
    }
    .legend-desc {
      font-size: 0.68rem;
      color: var(--warm-gray);
      opacity: 0.6;
      line-height: 1.4;
    }

    /* Track breakdown */
    .breakdown-section {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .breakdown-card {
      background: rgba(20,28,36,0.8);
      border: 1px solid rgba(232,168,38,0.12);
      border-radius: 8px;
      padding: 1.25rem;
    }
    .breakdown-title {
      font-size: 0.75rem;
      color: var(--amber);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
    }
    .track-bar-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.6rem;
    }
    .track-name {
      font-size: 0.7rem;
      width: 55px;
      color: var(--warm-gray);
      opacity: 0.7;
      flex-shrink: 0;
    }
    .track-bar-bg {
      flex: 1;
      height: 6px;
      background: rgba(34,47,62,0.8);
      border-radius: 3px;
      overflow: hidden;
    }
    .track-bar-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.8s ease;
    }
    .track-pct {
      font-size: 0.7rem;
      color: var(--warm-gray);
      width: 36px;
      text-align: right;
      flex-shrink: 0;
    }

    /* Timeline */
    .timeline {
      background: rgba(20,28,36,0.8);
      border: 1px solid rgba(232,168,38,0.12);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .timeline-title {
      font-size: 0.8rem;
      color: var(--amber);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1.5rem;
    }
    .timeline-items {
      position: relative;
      padding-left: 1.5rem;
    }
    .timeline-items::before {
      content: '';
      position: absolute;
      left: 5px;
      top: 0;
      bottom: 0;
      width: 1px;
      background: rgba(232,168,38,0.15);
    }
    .timeline-item {
      position: relative;
      margin-bottom: 1.5rem;
    }
    .timeline-item::before {
      content: '';
      position: absolute;
      left: -1.25rem;
      top: 5px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--amber);
      border: 2px solid var(--charcoal);
    }
    .timeline-step {
      font-size: 0.68rem;
      color: var(--warm-gray);
      opacity: 0.5;
      margin-bottom: 0.25rem;
    }
    .timeline-label {
      font-size: 0.82rem;
      color: var(--amber);
      font-weight: 600;
      margin-bottom: 0.2rem;
    }
    .timeline-model-tag {
      display: inline-block;
      font-size: 0.65rem;
      padding: 0.15rem 0.5rem;
      background: rgba(232,168,38,0.1);
      border: 1px solid rgba(232,168,38,0.2);
      border-radius: 3px;
      color: var(--warm-gray);
    }

    /* Footer note */
    .footer-note {
      font-size: 0.72rem;
      color: var(--warm-gray);
      opacity: 0.4;
      text-align: center;
      padding-top: 2rem;
      border-top: 1px solid rgba(232,168,38,0.08);
    }

    /* Pulse for in-progress */
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .pulse { animation: pulse 2s infinite; }

    /* Responsive */
    @media (max-width: 640px) {
      .hero { padding: 2rem 1rem 1.5rem; }
      .main { padding: 0 1rem 3rem; }
      .nav { padding: 0.75rem 1rem; }
    }
  </style>
</head>
